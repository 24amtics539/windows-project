<UserControl x:Class="ExpenseManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
  <StackPanel>
    <Grid Margin="0,0,0,22">
      <StackPanel><TextBlock x:Name="Welcome" Style="{StaticResource Title}"/><TextBlock x:Name="Period" Text="Here is your financial overview" Style="{StaticResource Subtitle}"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Tag="Expense" Click="QuickAdd_Click" Style="{StaticResource DangerButton}" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Add expense"/></StackPanel></Button><Button Tag="Income" Click="QuickAdd_Click" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Add income"/></StackPanel></Button></StackPanel>
    </Grid>

    <UniformGrid Columns="4" Margin="0,0,0,8">
      <Border Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource InfoLightBrush}"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="BALANCE" Style="{StaticResource Label}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="Balance" FontSize="25" FontWeight="Bold" Margin="0,15,0,0"/><TextBlock Text="Available after expenses" Style="{StaticResource Subtitle}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SuccessLightBrush}"><TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="TOTAL INCOME" Style="{StaticResource Label}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="Income" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,15,0,0"/><TextBlock Text="Money received" Style="{StaticResource Subtitle}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource DangerLightBrush}"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="TOTAL EXPENSES" Style="{StaticResource Label}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="Expense" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,15,0,0"/><TextBlock Text="Money spent" Style="{StaticResource Subtitle}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource WarningLightBrush}"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="SAVINGS RATE" Style="{StaticResource Label}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="SavingsRate" FontSize="25" FontWeight="Bold" Margin="0,15,0,0"/><TextBlock x:Name="Count" Style="{StaticResource Subtitle}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
    </UniformGrid>

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel><Grid><TextBlock Text="Spending overview" Style="{StaticResource SectionTitle}"/><TextBlock Text="Last 6 months" Style="{StaticResource Subtitle}" HorizontalAlignment="Right"/></Grid><ItemsControl x:Name="MonthlyChart"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" Style="{StaticResource ChartBar}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Display}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Expense categories" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="CategoryChart"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" Style="{StaticResource ChartBar}" VerticalAlignment="Center" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoCategories" Text="No expense data yet" Style="{StaticResource Subtitle}" Visibility="Collapsed" Margin="0,10,0,0"/></StackPanel></Border>
    </Grid>

    <Grid Margin="0,0,0,8"><TextBlock Text="Recent transactions" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="RecentCount" HorizontalAlignment="Right" Style="{StaticResource Subtitle}"/></Grid>
    <Border Style="{StaticResource Card}" Padding="18" Margin="0"><StackPanel>
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition/><ColumnDefinition Width="125"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="TYPE" Style="{StaticResource Label}" Margin="0"/><TextBlock Grid.Column="1" Text="NAME / CATEGORY" Style="{StaticResource Label}" Margin="0"/><TextBlock Grid.Column="2" Text="DATE" Style="{StaticResource Label}" Margin="0"/><TextBlock Grid.Column="3" Text="AMOUNT" Style="{StaticResource Label}" Margin="0" HorizontalAlignment="Right"/></Grid>
      <ListView x:Name="Recent" BorderThickness="0" Background="Transparent" Height="260" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition/><ColumnDefinition Width="125"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource InfoLightBrush}"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Type}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Date, StringFormat=dd MMM yyyy}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat=&#x20B9; {0:N2}}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
    </StackPanel></Border>
  </StackPanel>
</UserControl>
