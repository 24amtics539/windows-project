<UserControl x:Class="ExpenseManager.Views.EntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
  <Grid>
    <Border Style="{StaticResource Card}" Width="760" HorizontalAlignment="Left" Padding="28" Margin="0,0,0,20">
      <StackPanel>
        <Grid Margin="0,0,0,14"><StackPanel><TextBlock x:Name="Heading" Style="{StaticResource Title}"/><TextBlock Text="Add the details so your dashboard stays accurate." Style="{StaticResource Subtitle}"/></StackPanel><Border x:Name="TypeBadge" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="14" Padding="12,7" Background="{DynamicResource InfoLightBrush}"><TextBlock x:Name="TypeText" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/></Border></Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="NAME / SOURCE" Style="{StaticResource Label}"/><TextBox x:Name="NameBox" ToolTip="For example, Grocery store or monthly salary"/>
            <TextBlock Text="CATEGORY" Style="{StaticResource Label}"/><ComboBox x:Name="CategoryBox"/>
            <TextBlock Text="AMOUNT" Style="{StaticResource Label}"/><Grid><TextBlock Text="&#x20B9;" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="AmountBox" Padding="28,10,12,10"/></Grid>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="DATE" Style="{StaticResource Label}"/><DatePicker x:Name="DateBox"/>
            <TextBlock Text="PAYMENT METHOD" Style="{StaticResource Label}"/><ComboBox x:Name="PaymentBox"/>
            <TextBlock Text="DESCRIPTION" Style="{StaticResource Label}"/><TextBox x:Name="DescriptionBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="Message" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Clear" Click="Clear_Click" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/><Button Style="{StaticResource PrimaryButton}" Click="Save_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Save transaction"/></StackPanel></Button></StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
