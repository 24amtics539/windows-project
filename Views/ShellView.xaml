<UserControl x:Class="ExpenseManager.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition/></Grid.ColumnDefinitions>

    <Border Background="{DynamicResource SidebarBrush}">
      <DockPanel Margin="18,22">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="8,0,0,42">
            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource PrimaryBrush}" Margin="0,0,10,0">
              <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Expense" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="MANAGER" Foreground="{DynamicResource SecondaryBrush}" FontSize="9" FontWeight="Bold"/></StackPanel>
          </StackPanel>
          <TextBlock Text="OVERVIEW" Foreground="#7F8BA8" FontSize="10" FontWeight="SemiBold" Margin="13,0,0,8"/>
          <StackPanel x:Name="NavItems">
            <Button x:Name="DashboardNav" Tag="Dashboard" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Foreground="{DynamicResource SidebarTextBrush}" Style="{StaticResource Icon}" Margin="0,0,13,0"/><TextBlock Text="Dashboard" Foreground="{DynamicResource SidebarTextBrush}"/></StackPanel></Button>
            <Button x:Name="TransactionsNav" Tag="Transactions" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Foreground="{DynamicResource SidebarTextBrush}" Style="{StaticResource Icon}" Margin="0,0,13,0"/><TextBlock Text="Transactions" Foreground="{DynamicResource SidebarTextBrush}"/></StackPanel></Button>
            <Button x:Name="ReportsNav" Tag="Reports" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Foreground="{DynamicResource SidebarTextBrush}" Style="{StaticResource Icon}" Margin="0,0,13,0"/><TextBlock Text="Reports" Foreground="{DynamicResource SidebarTextBrush}"/></StackPanel></Button>
          </StackPanel>
          <TextBlock Text="QUICK ACTIONS" Foreground="#7F8BA8" FontSize="10" FontWeight="SemiBold" Margin="13,28,0,8"/>
          <Button Tag="Expense" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Foreground="{DynamicResource SidebarTextBrush}" Style="{StaticResource Icon}" Margin="0,0,13,0"/><TextBlock Text="Add expense" Foreground="{DynamicResource SidebarTextBrush}"/></StackPanel></Button>
          <Button Tag="Income" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Foreground="{DynamicResource SidebarTextBrush}" Style="{StaticResource Icon}" Margin="0,0,13,0"/><TextBlock Text="Add income" Foreground="{DynamicResource SidebarTextBrush}"/></StackPanel></Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Tag="Logout" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AC;" Foreground="{DynamicResource SidebarTextBrush}" Style="{StaticResource Icon}" Margin="0,0,13,0"/><TextBlock Text="Log out" Foreground="{DynamicResource SidebarTextBrush}"/></StackPanel></Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition/></Grid.RowDefinitions>
      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,18">
        <Grid>
          <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Your financial overview" Style="{StaticResource Subtitle}" Margin="0,3,0,0"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="ThemeButton" Click="Theme_Click" Style="{StaticResource IconButton}" ToolTip="Toggle dark mode" Margin="0,0,16,0"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ThemeIcon" Text="&#xE706;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock x:Name="ThemeLabel" Text="Dark mode"/></StackPanel></Button>
            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource InfoLightBrush}" Margin="0,0,10,0"><TextBlock x:Name="UserInitials" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="UserName" FontWeight="SemiBold"/><TextBlock Text="Personal account" Style="{StaticResource Subtitle}" FontSize="11"/></StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ContentControl x:Name="Page" Margin="30"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
