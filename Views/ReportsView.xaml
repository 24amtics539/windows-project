<UserControl x:Class="ExpenseManager.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
  <StackPanel>
    <Grid Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="Reports" Style="{StaticResource Title}"/>
        <TextBlock Text="A clearer view of your financial habits" Style="{StaticResource Subtitle}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Click="Export_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
            <TextBlock Text="Export report PDF"/>
          </StackPanel>
        </Button>
        <Button Click="ExportExcel_Click" Style="{StaticResource GhostButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
            <TextBlock Text="Export report Excel"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <UniformGrid Columns="3" Margin="0,0,0,8">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TOTAL INCOME" Style="{StaticResource Label}" Margin="0"/><TextBlock x:Name="TotalIncome" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,14,0,0"/><TextBlock Text="All recorded income" Style="{StaticResource Subtitle}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TOTAL EXPENSES" Style="{StaticResource Label}" Margin="0"/><TextBlock x:Name="TotalExpense" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,14,0,0"/><TextBlock Text="All recorded expenses" Style="{StaticResource Subtitle}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TOP CATEGORY" Style="{StaticResource Label}" Margin="0"/><TextBlock x:Name="TopCategory" FontSize="25" FontWeight="Bold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TopCategoryValue" Style="{StaticResource Subtitle}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
    </UniformGrid>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel><TextBlock Text="Monthly expenses" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="MonthlyReport"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" Style="{StaticResource ChartBar}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Category breakdown" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="CategoryReport"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" Style="{StaticResource ChartBar}" VerticalAlignment="Center" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding Display}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="EmptyReport" Text="Add expenses to see your breakdown." Style="{StaticResource Subtitle}" Visibility="Collapsed" Margin="0,12,0,0"/></StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource Card}" Padding="18" Margin="0"><StackPanel><Grid><TextBlock Text="Report summary" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ReportCount" HorizontalAlignment="Right" Style="{StaticResource Subtitle}"/></Grid><TextBlock x:Name="ReportSummary" TextWrapping="Wrap" Style="{StaticResource Subtitle}" LineHeight="24"/></StackPanel></Border>
  </StackPanel>
</UserControl>
