<UserControl x:Class="ExpenseManager.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageRoot}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="Transactions" Style="{StaticResource Title}"/><TextBlock Text="Every income and expense in one place" Style="{StaticResource Subtitle}"/></StackPanel><Button Click="NewTransaction_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="New transaction"/></StackPanel></Button></Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,10,0"><TextBox x:Name="SearchBox" TextChanged="Filter_Changed" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" ToolTip="Search name, category or description"/><TextBlock x:Name="SearchHint" Text="Search transactions..." Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"/></Grid>
        <ComboBox x:Name="FilterBox" Grid.Column="1" Margin="0,0,10,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="All types"/><ComboBoxItem Content="Income"/><ComboBoxItem Content="Expense"/></ComboBox>
        <ComboBox x:Name="CategoryFilter" Grid.Column="2" Margin="0,0,10,0" SelectionChanged="Filter_Changed" ToolTip="Filter by category"/>
        <ComboBox x:Name="PaymentFilter" Grid.Column="3" Margin="0,0,10,0" SelectionChanged="Filter_Changed" ToolTip="Filter by payment method"/>
        <DatePicker x:Name="FromDate" Grid.Column="4" Margin="0,0,10,0" SelectedDateChanged="Filter_Changed" ToolTip="From date"/>
        <Button Grid.Column="5" Content="Clear" Click="ClearFilters_Click" Style="{StaticResource GhostButton}" Padding="13,8"/>
        <TextBlock x:Name="ResultCount" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Subtitle}"/>
        <DatePicker x:Name="ToDate" Grid.Row="1" Grid.Column="4" Margin="0,0,10,0" SelectedDateChanged="Filter_Changed" ToolTip="To date"/>
        <Button Grid.Row="1" Grid.Column="5" Click="Export_Click" Style="{StaticResource GhostButton}" Padding="13,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" Margin="0,0,7,0"/><TextBlock Text="Export PDF"/></StackPanel></Button>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0">
      <DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="58" BorderThickness="0" MouseDoubleClick="Edit_Click">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="DATE" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="14,0"><TextBlock Text="{Binding Date, StringFormat=dd MMM yyyy}" FontWeight="SemiBold"/><TextBlock Text="{Binding Date, StringFormat=dddd}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="TYPE" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource InfoLightBrush}"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Type}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="TRANSACTION" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="130"/>
          <DataGridTextColumn Header="PAYMENT" Binding="{Binding PaymentMethod}" Width="125"/>
          <DataGridTemplateColumn Header="AMOUNT" Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Amount, StringFormat=&#x20B9; {0:N2}}" HorizontalAlignment="Right" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="Income"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="ACTIONS" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Tag="{Binding}" Click="Edit_Click" Style="{StaticResource IconButton}" ToolTip="Edit transaction" Margin="0,0,5,0" Padding="9,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Foreground="{DynamicResource PrimaryBrush}" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,5,0"/><TextBlock Text="Edit" Foreground="{DynamicResource PrimaryBrush}"/></StackPanel></Button><Button Tag="{Binding}" Click="Delete_Click" Style="{StaticResource DangerButton}" ToolTip="Delete transaction" Padding="9,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,5,0"/><TextBlock Text="Delete" Foreground="{DynamicResource DangerBrush}"/></StackPanel></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
